# Infynit AI - dock inferior (tint2): lançadores fixos + lista de janelas abertas.
# Backgrounds (ids na ordem): 1=painel  2=botão salmão  3=ativo/chip escuro  4=urgente
rounded = 16
border_width = 1
border_sides = TBLR
background_color = #0d0909 72
border_color = #3a2420 90
background_color_hover = #0d0909 72
border_color_hover = #3a2420 90
background_color_pressed = #0d0909 72
border_color_pressed = #3a2420 90

rounded = 12
border_width = 0
border_sides = TBLR
background_color = #ff8f7a 100
border_color = #ff8f7a 100
background_color_hover = #ffb4a2 100
border_color_hover = #ffb4a2 100
background_color_pressed = #e0201b 100
border_color_pressed = #e0201b 100

rounded = 18
border_width = 1
border_sides = TBLR
background_color = #181111 68
border_color = #ff8f7a 55
background_color_hover = #3a2420 80
border_color_hover = #ff8f7a 100
background_color_pressed = #3a2420 80
border_color_pressed = #ff8f7a 100

rounded = 12
border_width = 1
border_sides = TBLR
background_color = #e0201b 100
border_color = #ff5a4d 100
background_color_hover = #e0201b 100
border_color_hover = #ff5a4d 100
background_color_pressed = #e0201b 100
border_color_pressed = #ff5a4d 100

#-------------------------------------
panel_items = LT
panel_size = 96% 62
panel_margin = 0 6
panel_padding = 10 6 10
panel_background_id = 3
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = ambxst-dock
disable_transparency = 0
mouse_effects = 0
font_shadow = 0

#-------------------------------------
# Lista de janelas (alternar / minimizar com toque)
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 6 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
task_text = 1
task_icon = 1
task_centered = 1
task_maximum_size = 150 46
task_padding = 10 5 6
task_tooltip = 1
task_font = JetBrains Mono 9
task_font_color = #a58f8a 100
task_active_font_color = #f5e6e2 100
task_urgent_font_color = #f5e6e2 100
task_iconified_font_color = #6d5a56 100
task_background_id = 0
task_active_background_id = 2
task_urgent_background_id = 4
task_iconified_background_id = 0
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 60 0 0
urgent_nb_of_blink = 6
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none

#-------------------------------------
# Lançadores fixos (arquivos .desktop em ~/.local/share/applications)
launcher_padding = 4 2 8
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 42
launcher_icon_asb = 100 0 0
launcher_icon_theme = Papirus-Dark
launcher_icon_theme_override = 0
launcher_tooltip = 1
startup_notifications = 1
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-menu.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-categories.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-terminal.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-files.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-editor.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-browser.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-brave.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-trash.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-wallpaper.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-settings.desktop
launcher_item_app = /home/ambxst/.local/share/applications/ambxst-power.desktop

#-------------------------------------
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 6 4
tooltip_background_id = 3
tooltip_font = JetBrains Mono 9
tooltip_font_color = #f5e6e2 100
