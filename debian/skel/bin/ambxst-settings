#!/bin/bash
# ambxst-settings - configurações do sistema (todas as entradas têm ação real).
CONF="$HOME/.config/ambxst/ambxst.conf"
eco=$(grep -E '^AMBXST_ECO=' "$CONF" 2>/dev/null | tail -n1 | cut -d= -f2)
[ "$eco" = 1 ] && ecolabel="Modo econômico: LIGADO (tocar para desligar)" || ecolabel="Modo econômico: desligado (tocar para ligar)"
pkill -u "$(id -u)" -x rofi 2>/dev/null
choice=$(printf '%s\n' \
  "Papel de parede" \
  "$ecolabel" \
  "Aparência (tema GTK, ícones, fontes)" \
  "Editar configuração do Infynit AI" \
  "Atalhos de teclado (ajuda)" \
  "Reiniciar sessão gráfica" \
  | rofi -dmenu -i -no-custom -p "Configurações" -theme-str 'window{width:560px;} listview{lines:5;}')
case "$choice" in
  "Papel de parede") exec ambxst-wallpaper ;;
  Modo*)
    if [ "$eco" = 1 ]; then new=0; else new=1; fi
    if grep -q '^AMBXST_ECO=' "$CONF"; then sed -i "s|^AMBXST_ECO=.*|AMBXST_ECO=$new|" "$CONF"; else echo "AMBXST_ECO=$new" >> "$CONF"; fi
    notify-send "Modo econômico" "Alterado para $new. Use 'Reiniciar sessão gráfica' para aplicar."
    ;;
  Aparência*) exec lxappearance ;;
  Editar*) exec mousepad "$CONF" ;;
  Atalhos*) exec mousepad "$HOME/.config/ambxst/ATALHOS.txt" ;;
  Reiniciar*) touch /tmp/ambxst-restart; openbox --exit ;;
esac
