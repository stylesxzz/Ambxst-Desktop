#!/data/data/com.termux/files/usr/bin/bash
# ambxst-status - mostra se os serviços estão funcionando. (roda no TERMUX)
set -u
LIB="${AMBXST_HOME:-$HOME/.ambxst}/lib/common.sh"
[ -f "$LIB" ] || { echo "Infynit AI não instalado." >&2; exit 1; }
# shellcheck source=/dev/null
. "$LIB"

BAD=0
row() { # nome estado(0/1) detalhe
  if [ "$2" = 0 ]; then printf '  %s●%s %-22s %s\n' "$C_G" "$C_0" "$1" "$3"
  else printf '  %s●%s %-22s %s\n' "$C_R" "$C_0" "$1" "$3"; BAD=1; fi
}
proc_row() { # nome processo
  local n; n=$(pgrep -x "$2" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$n" -gt 0 ]; then row "$1" 0 "rodando ($n)"; else row "$1" 1 "parado"; fi
}

echo "Infynit AI - status"
[ -d "$AMBXST_ROOTFS" ] && row "Debian (proot-distro)" 0 "instalado" || row "Debian (proot-distro)" 1 "não instalado"
[ -f "$CONF_FILE" ] && row "Configuração" 0 "ok" || row "Configuração" 1 "ausente (rode ambxst-fix)"
echo "Termux:"
if x11_running; then row "Servidor Termux:X11" 0 "PID $(x11_pids | tr '\n' ' ')"; else row "Servidor Termux:X11" 1 "parado"; fi
[ -S "$X11_SOCKET" ] && row "Socket display :0" 0 "$X11_SOCKET" || row "Socket display :0" 1 "ausente"
SP=$(session_pid || true)
[ -n "$SP" ] && row "Supervisor da sessão" 0 "PID $SP" || row "Supervisor da sessão" 1 "parado"
if pulseaudio --check >/dev/null 2>&1; then row "PulseAudio" 0 "rodando"; else printf '  %s●%s %-22s %s\n' "$C_D" "$C_0" "PulseAudio" "parado (opcional)"; fi
echo "Dentro do Debian:"
proc_row "Openbox (janelas)" openbox
proc_row "tint2 (barra+dock)" tint2
proc_row "Notificações (dunst)" dunst
if [ "$(get_conf AMBXST_ECO 0)" = 1 ]; then
  printf '  %s●%s %-22s %s\n' "$C_D" "$C_0" "pcmanfm --desktop" "não usado (modo econômico)"
else
  proc_row "Desktop/ícones (pcmanfm)" pcmanfm
fi
echo "Sistema:"
awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{ if(t>0) printf "  RAM: %d MB usados de %d MB (livres %d MB)\n",(t-a)/1024,t/1024,a/1024 }' /proc/meminfo 2>/dev/null
echo "  Modo econômico: $([ "$(get_conf AMBXST_ECO 0)" = 1 ] && echo LIGADO || echo desligado)"
x11_app_installed; case $? in
  0) echo "  App Termux:X11: instalado" ;;
  1) warn "App Termux:X11 NÃO está instalado (instale o APK)." ; BAD=1 ;;
  *) echo "  App Termux:X11: não foi possível verificar" ;;
esac
echo
if [ "$BAD" = 0 ]; then ok "Tudo certo. Abra o app Termux:X11."; else warn "Algo não está rodando. Tente: ambxst-start   ou   ambxst-fix"; fi
exit "$BAD"
